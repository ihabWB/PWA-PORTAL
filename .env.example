# Copy to .env.local and fill in from the Supabase dashboard (Project Settings → API Keys).
# The same variables must be set in the Vercel project settings.
#
# This project uses Supabase's NEW API keys (sb_publishable_...). The legacy anon/service_role
# keys are deprecated and not used.
#
# NEVER add a secret key (sb_secret_...) to this project. It bypasses Row Level Security.
# If a task seems to need it, stop and discuss — it usually indicates a design problem.

NEXT_PUBLIC_SUPABASE_URL=
# Publishable key — safe to expose to the browser (RLS is the authorization boundary).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# IANA timezone used for rendering and daily boundaries.
NEXT_PUBLIC_APP_TIMEZONE=Asia/Hebron
