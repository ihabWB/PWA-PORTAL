# Copy to .env.local and fill in from the Supabase dashboard (Project Settings → API).
# The same variables must be set in the Vercel project settings.

NEXT_PUBLIC_SUPABASE_URL=
# Publishable/anon key — safe to expose to the browser (RLS is the authorization boundary).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Not used in Stage 1.
SUPABASE_SERVICE_ROLE_KEY=

# IANA timezone used for rendering and daily boundaries.
NEXT_PUBLIC_APP_TIMEZONE=Asia/Hebron
